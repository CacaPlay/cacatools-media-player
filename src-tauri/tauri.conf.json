{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CacaTools Media Player",
  "version": "0.1.1",
  "identifier": "lat.cacaplay.cacatools.mediaplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "CacaTools Media Player",
      "width": 1180,
      "height": 720,
      "minWidth": 320,
      "minHeight": 240,
      "resizable": true,
      "decorations": false,
      "center": true,
      "visible": true
    }],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "script-src": "'self' asset:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "capabilities": ["main-capability"],
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Video",
    "publisher": "CacaPlay",
    "shortDescription": "Reproductor multimedia local minimalista",
    "longDescription": "Reproductor local de vídeo y audio con listas de reproducción.",
    "copyright": "Copyright 2026 CacaPlay",
    "fileAssociations": [{
      "ext": ["mp4", "webm", "mkv", "mov", "avi", "m4v", "mp3", "wav", "flac", "m4a", "aac", "ogg", "opus"],
      "name": "CacaTools Media Player Media",
      "description": "Archivo multimedia reproducible con CacaTools Media Player",
      "role": "Viewer"
    }],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "CacaTools Media Player"
      }
    }
  },
  "plugins": {}
}
